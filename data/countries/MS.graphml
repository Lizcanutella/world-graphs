    <edge source="MS-A" target="MS-G"><data key="sources">natural_earth</data><data key="rule">ne_uncheckable</data><data key="corroborated">false</data></edge>
    <edge source="MS-A" target="MS-P"><data key="sources">natural_earth</data><data key="rule">ne_uncheckable</data><data key="corroborated">false</data></edge>
    <edge source="MS-G" target="MS-P"><data key="sources">natural_earth</data><data key="rule">ne_uncheckable</data><data key="corroborated">false</data></edge>
  </graph>
</graphml>
